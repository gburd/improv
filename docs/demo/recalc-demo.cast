[0.604, "o", "\u001b[1;36m# Derived measures — formulas over names, incrementally recalculated\u001b[0m\r\n"]
[1.103, "o", "\u001b[1;32m$ improv define /tmp/improv-recalc-iIpL.db 200 Revenue = Price * Quantity\u001b[0m\r\n"]
[0.236, "o", "defined derived measure 200 'Revenue'\r\n"]
[0.019, "o", "\u001b[1;32m$ improv define /tmp/improv-recalc-iIpL.db 201 TotalByProduct = SUM(Revenue OVER Time)\u001b[0m\r\n"]
[0.239, "o", "defined derived measure 201 'TotalByProduct'\r\n"]
[0.024, "o", "\u001b[1;32m$ improv eval /tmp/improv-recalc-iIpL.db 200\u001b[0m\r\n"]
