#compdef improv-tui

autoload -U is-at-least

_improv-tui() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
':model -- The model\: a store file, or postgres\://USER@HOST/DB?model=NAME:_default' \
&& ret=0
}

(( $+functions[_improv-tui_commands] )) ||
_improv-tui_commands() {
    local commands; commands=()
    _describe -t commands 'improv-tui commands' commands "$@"
}

if [ "$funcstack[1]" = "_improv-tui" ]; then
    _improv-tui "$@"
else
    compdef _improv-tui improv-tui
fi
