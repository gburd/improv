#compdef improv-gui

autoload -U is-at-least

_improv-gui() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::model -- The model\: a store file, or postgres\://USER@HOST/DB?model=NAME. Without it the model is in memory only:_default' \
&& ret=0
}

(( $+functions[_improv-gui_commands] )) ||
_improv-gui_commands() {
    local commands; commands=()
    _describe -t commands 'improv-gui commands' commands "$@"
}

if [ "$funcstack[1]" = "_improv-gui" ]; then
    _improv-gui "$@"
else
    compdef _improv-gui improv-gui
fi
