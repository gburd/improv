            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "delete": {
        "summary": "Delete a measure",
        "x-improv-scope": "write",
        "description": "Refused while a formula reads it.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "responses": {
          "200": {
            "description": "Done.",
