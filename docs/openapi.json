{
  "openapi": "3.1.0",
  "info": {
    "title": "improv-server",
    "version": "1",
    "description": "JSON HTTP API over one Improv model. Every path is also served without the /v1 prefix (an alias kept for older clients). `x-improv-scope` names the token scope a route needs: public (no token), read, or write. A missing or unknown token gets 401, a read token on a write route 403, an over-limit body 413, a caller over its rate limit 429.",
    "license": { "name": "Apache-2.0 OR MIT" }
  },
  "security": [{ "bearer": [] }],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Liveness probe",
        "x-improv-scope": "public",
        "security": [],
        "responses": {
          "200": { "description": "The text `ok`.", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "x-improv-scope": "public",
        "security": [],
        "responses": {
          "200": { "description": "The OpenAPI document.", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/v1/model": {
      "get": {
        "summary": "The whole model",
        "description": "Unstable: the body is the store's internal serialization of the model (ids, expression trees, function ids as numbers) and may change in any release. Not covered by the /v1 compatibility promise; use /v1/measures and /v1/measures/{id}/values for a stable view.",
        "x-improv-scope": "read",
        "x-improv-unstable": true,
        "responses": {
          "200": { "description": "The model, as the store serializes it.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/measures": {
      "get": {
        "summary": "List the measures",
        "x-improv-scope": "read",
        "responses": {
          "200": {
            "description": "Measures, sorted by id.",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MeasureSummary" } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "post": {
        "summary": "Define a measure",
        "x-improv-scope": "write",
        "description": "A derived measure or LAMBDA from a definition, or a new input measure. A formula error is located in the text (`diagnostic`).",
        "parameters": [{ "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Define" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/measures/{id}/values": {
      "get": {
        "summary": "A measure's values",
        "description": "The stored cells of an input measure, or the computed cells of a derived one.",
        "x-improv-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/MeasureId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Cells" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/measures/{id}/eval": {
      "post": {
        "summary": "What-if evaluation",
        "description": "Apply edits through the live engine and return derived measure `id`. A read token may evaluate; `\"persist\": true` writes the edits and needs a write token (403 otherwise). A persisting request is audited.",
        "x-improv-scope": "read",
        "parameters": [{ "$ref": "#/components/parameters/MeasureId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvalRequest" } } }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Cells" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/measures/{id}/cells": {
      "post": {
        "summary": "Set one input cell",
        "x-improv-scope": "write",
        "parameters": [{ "$ref": "#/components/parameters/MeasureId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetCellRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Written.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "const": true } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/nl/parse": {
      "post": {
        "summary": "Controlled English to a formula",
        "x-improv-scope": "read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } },
              "example": { "text": "revenue is price times quantity" }
            }
          }
        },
        "responses": {
          "200": { "description": "The formula.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/nl/describe": {
      "post": {
        "summary": "A formula to controlled English",
        "x-improv-scope": "read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["formula"],
                "properties": { "formula": { "type": "object", "description": "A formula as /v1/nl/parse returns it." } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The text.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "text": { "type": "string" } } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/scheduler/status": {
      "get": {
        "summary": "Refresh scheduler state",
        "x-improv-scope": "read",
        "responses": {
          "200": {
            "description": "`enabled` false, or the tick period and the last tick's outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["enabled"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "tick_secs": { "type": "integer" },
                    "last_tick_refreshed": { "type": "array", "items": { "type": "integer" } },
                    "last_error": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/categories": {
      "post": {
        "summary": "Add a category",
        "x-improv-scope": "write",
        "parameters": [{ "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Name" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/categories/{id}": {
      "put": {
        "summary": "Rename a category",
        "x-improv-scope": "write",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Name" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "delete": {
        "summary": "Delete a category",
        "x-improv-scope": "write",
        "description": "With its items. Refused while a measure uses it.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/categories/{id}/items": {
      "post": {
        "summary": "Add an item",
        "x-improv-scope": "write",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Name" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/cells": {
      "post": {
        "summary": "Edit cells",
        "x-improv-scope": "write",
        "description": "Set or clear input cells, all or none. A refusal names the failing edit (`index`); a hidden cell is refused as one that does not exist. Never a conflict: when another writer moved the model, the server reloads, checks the batch again and applies it.",
        "parameters": [{ "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EditBatch" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/changes": {
      "get": {
        "summary": "Changes, as Server-Sent Events",
        "x-improv-scope": "read",
        "description": "A `text/event-stream`. The first event carries the current version, or what changed since `since`. Then one event per change the caller may see: the changed cells, filtered for the caller, or `reload`. A change the caller may see none of sends nothing. Each event's `id` is its version; reconnect with `?since=` (or `Last-Event-ID`) to resume. A stream is not bound by the request time limit and takes no in-flight slot; at most IMPROV_MAX_STREAMS (default 256) are open at once, 8 per caller, with 429 past either.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "The last version this client saw.",
            "schema": { "$ref": "#/components/schemas/Version" }
          }
        ],
        "responses": {
          "200": {
            "description": "The event stream; each `data:` line is a ChangeEvent.",
            "content": { "text/event-stream": { "schema": { "$ref": "#/components/schemas/ChangeEvent" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": {
            "description": "Over the rate limit, or too many change streams open (in all, or for this caller).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Failure" } } }
          },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/items/{id}": {
      "put": {
        "summary": "Rename an item",
        "x-improv-scope": "write",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Name" } } }
        },
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      },
      "delete": {
        "summary": "Delete an item",
        "x-improv-scope": "write",
        "description": "With its cells.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "responses": {
          "200": {
            "description": "Done.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Done" } } }
          },
          "400": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "404": { "$ref": "#/components/responses/Refused" },
          "409": { "$ref": "#/components/responses/Refused" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/Internal" }
        }
      }
    },
    "/v1/measures/{id}": {
      "put": {
        "summary": "Change a measure",
        "x-improv-scope": "write",
        "description": "A new formula (an error located in it), name or number format.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Session" }],
        "requestBody": {
          "required": true,
